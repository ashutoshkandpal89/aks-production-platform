   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "No stored secrets anywhere: the pipeline and the pod prove who they are with tokens, and Flux pulls from Git.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "No stored secrets anywhere: the pipeline and the pod prove who they are with tokens, and Flux pulls from Git.",
   "autoResize": true,
   "lineHeight": 1.25
  },
